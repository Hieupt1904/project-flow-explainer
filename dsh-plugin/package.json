{
  "name": "dsh-project-flow-explainer",
  "version": "0.6.3",
  "type": "module",
  "description": "DSH adapter: expose the Project Flow Explainer core (scripts/build_flow.py + template) as one DSH tool. Ships the core under vendor/core so a packed install works without the checkout.",
  "license": "MIT",
  "author": "Hieupt1904",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hieupt1904/project-flow-explainer.git",
    "directory": "dsh-plugin"
  },
  "homepage": "https://github.com/Hieupt1904/project-flow-explainer",
  "bugs": {
    "url": "https://github.com/Hieupt1904/project-flow-explainer/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "code-analysis",
    "flow-diagram",
    "codebase",
    "offline-html",
    "agent-tool"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "client.js",
    "index.js",
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "vendor/core/scripts/build_flow.py",
    "vendor/core/scripts/render_flow.py",
    "vendor/core/assets/workflow_template.html",
    "vendor/core/tools/pfe_cli.py",
    "vendor/core/pfe/"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "0.2.2-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.5 <4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/plugin.test.mjs",
    "pack:bundle": "node scripts/pack.mjs"
  }
}

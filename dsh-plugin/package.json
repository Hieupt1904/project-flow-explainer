{
  "name": "dsh-project-flow-explainer",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "DSH adapter: expose the Project Flow Explainer core (scripts/build_flow.py + template) as one DSH tool. Ships the core under vendor/core so a packed install works without the checkout.",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "vendor/core/scripts/build_flow.py",
    "vendor/core/scripts/render_flow.py",
    "vendor/core/assets/workflow_template.html"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "0.2.2-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/plugin.test.mjs",
    "pack:bundle": "node scripts/pack.mjs"
  }
}
